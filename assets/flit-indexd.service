[Unit]
Description=Flit search index
Documentation=https://github.com/brano-san/Flit

[Service]
Type=simple
ExecStart=/usr/bin/flit-indexd
Restart=on-failure
RestartSec=10
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
StateDirectory=flit
StateDirectoryMode=0700
ReadWritePaths=%t -%S/indexd
PrivateTmp=yes

[Install]
WantedBy=default.target
Also=flit-indexd.socket
